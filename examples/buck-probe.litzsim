{
  "version": 3,
  "simulation": {
    "timeStep_s": 1e-7,
    "stopTime_s": 0.001
  },
  "parts": {
    "V1": {
      "type": "dc",
      "parameters": {
        "voltage_V": 5
      }
    },
    "R1": {
      "type": "resistor",
      "parameters": {
        "resistance_ohm": 1000
      }
    },
    "C1": {
      "type": "capacitor",
      "parameters": {
        "capacitance_F": 0.000001,
        "initialVoltage_V": 0
      }
    },
    "GND": {
      "type": "ground",
      "parameters": {}
    },
    "VP1": {
      "type": "voltageProbe",
      "parameters": {}
    },
    "VC": {
      "type": "voltmeter",
      "parameters": {}
    },
    "Q1": {
      "type": "nmos",
      "parameters": {}
    },
    "D1": {
      "type": "diode",
      "parameters": {}
    },
    "L1": {
      "type": "inductor",
      "parameters": {
        "inductance_H": 0.001,
        "initialCurrent_A": 0
      }
    },
    "PWM": {
      "type": "pwm",
      "parameters": {
        "frequency_Hz": 10000,
        "duty": 0.5,
        "high_V": 10
      }
    }
  },
  "nets": {
    "input": [
      "V1.p",
      "Q1.d"
    ],
    "gate": [
      "PWM.out",
      "Q1.g"
    ],
    "sw": [
      "Q1.s",
      "PWM.ref",
      "D1.k",
      "L1.p",
      "VP1.p"
    ],
    "output": [
      "L1.n",
      "C1.p",
      "R1.p",
      "VC.p"
    ],
    "ground": [
      "GND.ref",
      "V1.n",
      "D1.a",
      "C1.n",
      "R1.n",
      "VC.n"
    ]
  },
  "layout": {
    "V1": {
      "x": 0,
      "y": 5
    },
    "Q1": {
      "x": 8,
      "y": 2
    },
    "PWM": {
      "x": 4,
      "y": 3
    },
    "D1": {
      "x": 11,
      "y": 5
    },
    "L1": {
      "x": 13,
      "y": 4
    },
    "C1": {
      "x": 16,
      "y": 5
    },
    "R1": {
      "x": 20,
      "y": 5,
      "rotation": 90
    },
    "VC": {
      "x": 24,
      "y": 5
    },
    "VP1": {
      "x": 11,
      "y": 2
    },
    "GND": {
      "x": 11,
      "y": 7
    }
  },
  "bends": {
    "Q1.d": {
      "x": 0,
      "y": 1
    }
  }
}
